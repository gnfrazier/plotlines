# Pi5 QA/UAT elevation proxy config (issue #450, companion to #304).
# Copy to .env in this same directory (git-ignored — .gitignore's blanket
# `.env*` / `!.env.example` rule covers this file the same way it covers
# service/.env.example) and fill in the real value. Never commit .env
# itself. docker compose reads it automatically at `docker compose up`
# time; deploy/elevation/docker-compose.yml never holds a literal.
#
# The real key lives only here on the Pi (and in OpenTopography's own
# account records) — no QA/dev tester machine ever sets this.
# core/plotlines_core/elevation/qa_proxy_client.py's entire point is a
# sidecar-side fetcher that carries no API key at all; testers point at
# this proxy with PLOTLINES_ELEVATION_UPSTREAM instead (see
# deploy/elevation/README.md).
PLOTLINES_OPENTOPOGRAPHY_API_KEY=

# Optional. Defaults to free-non-academic (50 calls/24h, FR87) if left
# blank. Set to "enterprise" only if this Pi is ever issued a paid key —
# see core/plotlines_core/elevation/keys.py's KeyTier for the only two
# values this is allowed to hold.
PLOTLINES_OPENTOPOGRAPHY_KEY_TIER=
