# ============================================================================
# Plotlines — monorepo .gitignore
# Sectioned to match Plotlines_ARCHITECTURE.md's component map (§3):
# Flutter client (Tier 3), plotlines-core (Tier 1, Python), plotlines-service
# (Tier 2, FastAPI sidecar/hosted), plus cross-cutting build/secret/OS noise.
# ============================================================================

# ----------------------------------------------------------------------------
# Flutter / Dart client (Tier 3 — §9)
# See https://www.dartlang.org/guides/libraries/private-files
# ----------------------------------------------------------------------------
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map
# ...but this one is imported design reference (the .dc.html viewer runtime), not
# dart2js output. Without it both wireframes in client/design/ fail to render.
!client/design/support.js

.flutter-plugins
.flutter-plugins-dependencies

# Platform-specific build output (Android/iOS/desktop runners, Xcode user state)
*.iml
.gradle/
local.properties
**/android/**/gradle-wrapper.jar
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/*.xcuserstate
**/*.xcworkspace/xcuserdata/

# drift/SQLite local dev databases (Tier 3 local store — §9.2)
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ----------------------------------------------------------------------------
# Python — plotlines-core (Tier 1, §6) and plotlines-service (Tier 2, §7)
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / distribution
*.egg-info/
.eggs/
dist/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts (§14.1, §14.2)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Committed golden-route graph fixtures (§14.1) are intentionally NOT
# ignored — only large/derived caches below are. Keep fixtures under
# version control; ignore ad hoc local caches instead:
.cache/
graph_cache/
tile_cache/
elevation_cache/
# osmnx's Overpass response cache, and the derived --cache-dir a sidecar is pointed
# at (copied from committed fixtures — reproducible, so not worth committing twice)
cache/

# SPIKE-01/02/03 routing fixtures: 29 MB of graphs + DEMs across three regions.
# A deliberate exception to the keep-fixtures-committed rule above, on two grounds:
# they are exploratory spike inputs rather than §14.1 golden-route fixtures, and they
# rebuild from one command in ~2 min:
#     .venv/bin/python spikes/shared/regions.py
# Region bboxes live in spikes/shared/regions.py, which IS committed — that file, not
# the .graphml, is the reproducible definition. Promote a fixture here to committed if
# a golden test ever depends on it.
spikes/shared/fixtures/

# SPIKE-05 activity files (.fit/.gpx) — REAL PERSONAL GPS TRACES. Never commit.
# These are not "large build output that happens to be ignorable"; they are a record of
# where a specific person went and when. Committing one publishes a home address and a
# routine, permanently, in a history that is painful to rewrite. The spike is written to
# read them here and emit only derived metrics (durations, distances, speed
# distributions) — the derived JSON under spikes/SPIKE-05/results/ IS committed, the
# traces are not, and no coordinate is allowed to reach the write-up.
# This is also the shape the product must take: derive locally, share numbers, not tracks
# (PRD FR78's per-field consent means nothing if the "field" is a location history).
spikes/fit_files/
*.fit
*.gpx
*.tcx

# ----------------------------------------------------------------------------
# Sidecar packaging (§4, §12) — frozen binaries are build output, not source
# ----------------------------------------------------------------------------
*.spec
sidecar_dist/
sidecar_build/
*.exe
*.dmg
*.AppImage

# ----------------------------------------------------------------------------
# Secrets & credentials (§10.2 "absent, not unused" applies to the repo too)
# ----------------------------------------------------------------------------
# dotenv environment variables file — .env.example is the committed template,
# carved back out below (MVP doc §5: elevation API key lives in service/ config,
# never in the client, never in the repo)
.env*
!.env.example
!**/.env.example
*.local
*.pem
*.p12
*.mobileprovision
*.keystore
*.jks
secrets.json
credentials.json

# ----------------------------------------------------------------------------
# IDE / editor
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------------------------------------------------------
# OS noise
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
# WSL/Windows "mark of the web" sidecar files left on downloaded documents
*:Zone.Identifier

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
*.log

# SPIKE-14 vector-mapping inputs: 200 MB of tile archives, an exploded tile tree, and
# a 56 MB vendored CLI. All three are downloads or derivations of a download, not
# authored artifacts — the same reasoning as the routing fixtures above. What IS
# committed is the definition that reproduces them: the bboxes and commands in
# spikes/SPIKE-14/README.md, and probes/make_route.py for the route payloads.
# results/ (RESULTS.md, results.json, region_sizes.json, shots/) IS committed — it is
# the evidence, and the PNGs are ~180 KB each.
spikes/SPIKE-14/tiles/
spikes/SPIKE-14/tools/
spikes/SPIKE-14/harness/assets/tiles/
spikes/SPIKE-14/harness/assets/route_*.geojson
# Same rule, one derivation further out: style_labels.json is style_light.json with one
# property rewritten by probes/simplify_labels.py. The script is the definition.
spikes/SPIKE-14/harness/assets/style_labels.json
