# syntax=docker/dockerfile:1
# Plotlines mirror-side bbox clip — issue #262 (Phase 1.8 of epic #264,
# docs/Plotlines_OSM_Acquisition_Review.md §6.7). Runs on the Pi5 mirror
# host, containerized for the same reason Dockerfile.elevation-proxy is:
# pyosmium is a C++ extension (libosmium) — exactly the class of aarch64
# packaging risk a pinned base image with a known-good wheel sidesteps,
# rather than fighting apt/pip on the Pi directly.
#
# Build from the repo root (needs both core/ and service/):
#   docker build -f service/Dockerfile.mirror-clip -t plotlines-mirror-clip .
#
# pyosmium publishes manylinux wheels for x86_64 and aarch64 (confirmed
# against 4.3.1, the version pinned in service/pyproject.toml's base
# dependencies — issue #275/Phase 3.3 moved it there from the `mirror-clip`
# extra this comment used to describe, once SPIKE-J measured it as safe to
# ship in the frozen sidecar too), so this image needs no compiler and no
# libosmium apt install — but it does need one runtime library, and getting
# that wrong builds cleanly and then crash-loops (issue #369).
#
# A manylinux wheel vendors only what policy does *not* allowlist. Measured
# against the 4.3.1 wheel (`objdump -p` on every .so in the package — they
# all report the same list):
#
#   libz.so.1                      from the system  — present in slim
#   libstdc++.so.6                 from the system  — present in slim
#   libexpat.so.1                  from the system  — NOT present in slim
#   liblz4-c23f16fe.so.1.8.3       vendored in osmium.libs/
#   libbz2-a1e77c99.so.1.0.6       vendored in osmium.libs/
#
# So exactly one apt package is required: libexpat1. libosmium links expat
# unconditionally for OSM **XML** parsing, so `import osmium` fails at import
# time even though this service only ever reads .osm.pbf — the format is
# never reached. Do not add libbz2/liblz4 alongside it: they are vendored in
# the wheel, and installing them would assert a dependency that isn't real.
#
# No GPL-licensed binary anywhere in this image (addendum L1): the base
# dependency set installs `osmium` (pyosmium, BSD-2-Clause) only — never
# `osmium-tool` (GPL-3.0), which is not installed here and not shelled out to
# anywhere in plotlines_service/mirror_clip.py. libexpat1 is MIT and does not
# disturb that posture.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# Issue #519: the basemap fill runs `pmtiles extract` (protomaps_extract.py's
# own tool — see that script for why not tiles/extract.py against a planet
# archive). go-pmtiles is BSD-3-Clause, so addendum L1's no-GPL posture holds.
# Pinned to the release the Pi's host copy runs (1.31.2), checksum-verified
# per architecture; slim has no curl, so Python fetches it.
ARG TARGETARCH
ARG PMTILES_VERSION=1.31.2
RUN python - <<'PY'
import hashlib, io, os, tarfile, urllib.request
arch = {"arm64": "arm64", "amd64": "x86_64"}[os.environ.get("TARGETARCH") or "amd64"]
sums = {
    "arm64": "f8bd47e7ea866863489cad588fbaf2f31f42e5821f7a03f009b3769f05801cb1",
    "x86_64": "3ed7dbf4ec2e6dfe5e25b6f70d1ffc932729f93c86db353bf514dd71010a312f",
}
version = os.environ["PMTILES_VERSION"]
url = (f"https://github.com/protomaps/go-pmtiles/releases/download/v{version}/"
       f"go-pmtiles_{version}_Linux_{arch}.tar.gz")
body = urllib.request.urlopen(url, timeout=120).read()
assert hashlib.sha256(body).hexdigest() == sums[arch], "go-pmtiles checksum mismatch"
with tarfile.open(fileobj=io.BytesIO(body)) as tar:
    member = tar.getmember("pmtiles")
    with open("/usr/local/bin/pmtiles", "wb") as out:
        out.write(tar.extractfile(member).read())
os.chmod("/usr/local/bin/pmtiles", 0o755)
PY

WORKDIR /app
COPY core/ /app/core/
COPY service/ /app/service/
# Issue #518: the OSM fill pulls through geofabrik_pull.py's own etiquette
# rather than a second copy of it. mirror_fill_osm.py loads it from the same
# repo-relative place it sits in a checkout (<root>/deploy/mirror/).
COPY deploy/mirror/geofabrik_pull.py /app/deploy/mirror/geofabrik_pull.py
# Issue #519: the basemap fill uses protomaps_extract.py's build probe and
# extract wrapper the same way.
COPY deploy/mirror/protomaps_extract.py /app/deploy/mirror/protomaps_extract.py

WORKDIR /app/service
RUN uv sync --no-dev

# Single process, like Dockerfile.elevation-proxy: issue #494's concurrency
# bound (mirror_clip.py's --max-concurrent-clips) is in-memory, so
# --workers > 1 would give each worker its own independent bound instead of
# one shared across the mirror. Do not add --workers here.
ENTRYPOINT ["uv", "run", "python", "-m", "plotlines_service.mirror_clip"]
CMD ["--host", "0.0.0.0", "--port", "8095", "--root", "/srv/plotlines-mirror"]
