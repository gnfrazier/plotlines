# Pi5 QA/UAT caching elevation proxy — companion to epic #264, not #148.
# See service/plotlines_service/elevation_proxy.py for what this runs and why.
#
# Build from the repo root (needs both core/ and service/):
#   docker build -f service/Dockerfile.elevation-proxy -t plotlines-elevation-proxy .
#
# rasterio ships self-contained manylinux aarch64 wheels (bundled GDAL), so no
# separate GDAL apt install is needed. Its bundled GDAL .so does, however,
# dynamically link against the *system* libexpat rather than bundling it
# (confirmed live on the Pi 2026-09-19: python:3.12-slim doesn't carry
# libexpat.so.1, and the proxy container crash-looped on import with
# `ImportError: libexpat.so.1: cannot open shared object file`) — so that one
# runtime lib has to come from apt. If a pinned rasterio version ever lacks an
# aarch64 wheel, switch the base image to one that ships GDAL's shared libs
# (e.g. ghcr.io/osgeo/gdal) rather than compiling from source on the Pi.
FROM python:3.12-slim

RUN apt-get update && apt-get install --no-install-recommends -y libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY core/ /app/core/
COPY service/ /app/service/

WORKDIR /app/service
RUN uv sync --no-dev

# Single process by design — see elevation_proxy.py's module docstring on
# concurrency. Do not add --workers here.
ENTRYPOINT ["uv", "run", "python", "-m", "plotlines_service.elevation_proxy"]
CMD ["--host", "0.0.0.0", "--port", "8090", "--cache-dir", "/data"]
